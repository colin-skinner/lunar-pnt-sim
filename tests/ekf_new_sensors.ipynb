    "import plotly.graph_objects as go\n",
    "from lunanav.visualization import moon_surface\n",
    "\n",
    "def plot_satellites_3d_plotly(doppler_sats, lander_position=None, figsize=(1200, 1000)):\n",
    "    \"\"\"\n",
    "    Create interactive 3D Plotly plot of satellite orbits and lander trajectory.\n",
    "    \n",
    "    Args:\n",
    "        doppler_sats: list of SatPosVel objects\n",
    "        lander_position: optional array of lander positions (shape: [n, 3])\n",
    "        figsize: (width, height) in pixels\n",
    "    \"\"\"\n",
    "    fig = go.Figure()\n",
    "    \n",
    "    # Add moon surface\n",
    "    moon = moon_surface(radius=R_MOON, offset=np.zeros(3), resolution=30, color='#444444')\n",
    "    fig.add_trace(moon)\n",
    "    \n",
    "    # Satellite colors\n",
    "    sat_colors = ['#e74c3c', '#3498db', '#2ecc71']\n",
    "    \n",
    "    # Plot satellite trajectories\n",
    "    for i, sat in enumerate(doppler_sats):\n",
    "        # Full orbit line\n",
    "        fig.add_trace(go.Scatter3d(\n",
    "            x=sat.r[:, 0], y=sat.r[:, 1], z=sat.r[:, 2],\n",
    "            mode='lines',\n",
    "            name=f'Satellite {i} Orbit',\n",
    "            line=dict(color=sat_colors[i], width=4),\n",
    "            hovertemplate='<b>Sat %{customdata}</b><br>X: %{x:.0f}<br>Y: %{y:.0f}<br>Z: %{z:.0f}<extra></extra>',\n",
    "            customdata=[i]*len(sat.r)\n",
    "        ))\n",
    "        \n",
    "        # Start position\n",
    "        fig.add_trace(go.Scatter3d(\n",
    "            x=[sat.r[0, 0]], y=[sat.r[0, 1]], z=[sat.r[0, 2]],\n",
    "            mode='markers',\n",
    "            marker=dict(size=10, color=sat_colors[i], symbol='circle', \n",
    "                       line=dict(color='black', width=2)),\n",
    "            name=f'Sat {i} Start',\n",
    "            hovertemplate='<b>Sat {i} Start</b><br>X: %{x:.0f}<br>Y: %{y:.0f}<br>Z: %{z:.0f}<extra></extra>',\n",
    "            showlegend=False\n",
    "        ))\n",
    "        \n",
    "        # End position\n",
    "        fig.add_trace(go.Scatter3d(\n",
    "            x=[sat.r[-1, 0]], y=[sat.r[-1, 1]], z=[sat.r[-1, 2]],\n",
    "            mode='markers',\n",
    "            marker=dict(size=10, color=sat_colors[i], symbol='square', \n",
    "                       line=dict(color='black', width=2)),\n",
    "            name=f'Sat {i} End',\n",
    "            hovertemplate='<b>Sat {i} End</b><br>X: %{x:.0f}<br>Y: %{y:.0f}<br>Z: %{z:.0f}<extra></extra>',\n",
    "            showlegend=False\n",
    "        ))\n",
    "    \n",
    "    # Plot lander trajectory\n",
    "    if lander_position is not None:\n",
    "        fig.add_trace(go.Scatter3d(\n",
    "            x=lander_position[:, 0], y=lander_position[:, 1], z=lander_position[:, 2],\n",
    "            mode='lines',\n",
    "            name='Lander Trajectory',\n",
    "            line=dict(color='#9b59b6', width=5, dash='dash'),\n",
    "            hovertemplate='Lander<br>X: %{x:.0f}<br>Y: %{y:.0f}<br>Z: %{z:.0f}<extra></extra>'\n",
    "        ))\n",
    "        \n",
    "        # Lander start position\n",
    "        fig.add_trace(go.Scatter3d(\n",
    "            x=[lander_position[0, 0]], y=[lander_position[0, 1]], z=[lander_position[0, 2]],\n",
    "            mode='markers',\n",
    "            marker=dict(size=12, color='#9b59b6', symbol='diamond',\n",
    "                       line=dict(color='black', width=2)),\n",
    "            name='Lander Start',\n",
    "            hovertemplate='<b>Lander Start</b><br>X: %{x:.0f}<br>Y: %{y:.0f}<br>Z: %{z:.0f}<extra></extra>',\n",
    "            showlegend=False\n",
    "        ))\n",
    "    \n",
    "    # Calculate axis ranges\n",
    "    all_positions = [sat.r for sat in doppler_sats]\n",
    "    if lander_position is not None:\n",
    "        all_positions.append(lander_position)\n",
    "    \n",
    "    all_coords = np.vstack(all_positions)\n",
    "    max_range = max(np.max(np.abs(all_coords)) * 1.2, R_MOON * 1.5)\n",
    "    \n",
    "    # Update layout\n",
    "    fig.update_layout(\n",
    "        title=dict(\n",
    "            text='<b>Satellite Orbits & Lander Trajectory (Interactive 3D)</b>',\n",
    "            font=dict(size=18)\n",
    "        ),\n",
    "        scene=dict(\n",
    "            xaxis=dict(title='X (m)', backgroundcolor='rgb(240, 240, 240)', showbackground=True),\n",
    "            yaxis=dict(title='Y (m)', backgroundcolor='rgb(240, 240, 240)', showbackground=True),\n",
    "            zaxis=dict(title='Z (m)', backgroundcolor='rgb(240, 240, 240)', showbackground=True),\n",
    "            xaxis_range=[-max_range, max_range],\n",
    "            yaxis_range=[-max_range, max_range],\n",
    "            zaxis_range=[-max_range, max_range],\n",
    "            aspectmode='cube',\n",
    "            camera=dict(\n",
    "                eye=dict(x=1.5, y=1.5, z=1.3)\n",
    "            )\n",
    "        ),\n",
    "        width=figsize[0],\n",
    "        height=figsize[1],\n",
    "        hovermode='closest',\n",
    "        legend=dict(\n",
    "            x=0.02,\n",
    "            y=0.98,\n",
    "            bgcolor='rgba(255, 255, 255, 0.8)',\n",
    "            bordercolor='black',\n",
    "            borderwidth=1\n",
    "        ),\n",
    "        font=dict(size=12)\n",
    "    )\n",
    "    \n",
    "    return fig\n",
    "\n",
    "# Usage:\n",
    "fig = plot_satellites_3d_plotly(doppler_sats, lander_position=results.states[:, 0:3])\n",
    "fig.show()"
   ]
